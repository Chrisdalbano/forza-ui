{
  "name": "forza-ui-workspace",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1 --port 5196",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.build.json",
    "build:registry": "node scripts/registry.mjs",
    "build:brand": "node scripts/brand.mjs",
    "build": "npm run build:lib && npm run build:registry && vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1 --port 5196",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/cli.test.mjs",
    "test:browser": "playwright test",
    "typecheck:examples": "npm run build:registry && vue-tsc --noEmit -p .smoke/examples/tsconfig.json"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@lucide/vue": "^1.47.0",
    "embla-carousel-vue": "^8.6.0",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@svgdotjs/svg.js": "^3.2.5",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "gsap": "^3.15.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "shiki": "^2.5.0",
    "svgdom": "^0.1.22",
    "svgo": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "$vite"
  }
}
